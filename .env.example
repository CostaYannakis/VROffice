# Copy this file to .env (same folder as server.py) and fill in what you need. Every line is optional.

# Voice line (Gemini Live). Easiest: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or leave the key empty and use Vertex AI with Application Default Credentials
# (gcloud auth application-default login); these then pick the project and region.
OFFICE_GOOGLE_PROJECT=
OFFICE_GOOGLE_LOCATION=us-central1
# OFFICE_VOICE_MODEL=gemini-3.8-live

# Spending estimates for the voice line (app estimates, not a billing cap)
OFFICE_SESSION_USD=1.0
OFFICE_DAILY_USD=5.0
OFFICE_SESSION_MINUTES=15
OFFICE_IDLE_SECONDS=120

# OFFICE_PORT=8120
